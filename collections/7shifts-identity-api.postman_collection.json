          "name": "Retrieve Identity",
          "id": "9fff0cb8-aeb3-4652-9b17-9fbb5d1294cb",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/whoami",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "whoami"
              ]
            },
            "description": "Returns the identity associated with the authenticated access token."
          },
