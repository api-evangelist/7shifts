{
  "opencollection": "1.0.0",
  "info": {
    "name": "7shifts Availability Identity API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Identity",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Identity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.7shifts.com/whoami",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the identity associated with the authenticated access token."
        }
      ]
    }
  ],
  "bundled": true
}